# Dependências
node_modules/

# Build
dist/
build/
# Exceção: build/icon.ico do desktop-sync é um recurso de verdade (ícone
# fonte pro instalador Windows), não saída gerada — precisa ficar versionado.
!desktop-sync/build/
!desktop-sync/build/icon.ico

# Variáveis de ambiente (nunca versionar segredos)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / SO
.DS_Store
.vscode/
.idea/

# Cache
.vite/
*.tsbuildinfo
