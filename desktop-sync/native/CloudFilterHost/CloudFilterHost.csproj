<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Precisa mirar o Windows especificamente (não só "net8.0" genérico)
         pra ter acesso às APIs de Windows.Storage.Provider, que são
         exclusivas do Windows e não existem no .NET multiplataforma comum. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Ajustado depois do primeiro teste real: a API IsSupported() só
         garante existir a partir do build 19041 do Windows (versão 2004,
         "atualização de maio de 2020"), não do 17763 que eu tinha posto
         antes por engano - o build reportou isso como aviso (CA1416),
         corrigido aqui pra bater com a exigência real. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Permite compilar este projeto (que mira Windows) a partir de um
         sistema que não é Windows — só pra checagem de sintaxe/tipos
         aqui; o .exe final ainda precisa ser gerado e testado no Windows
         de verdade. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Necessário pelo trecho que usa "fixed"/ponteiro pra passar o
         conteúdo do arquivo de teste pro Windows sem cópia extra
         (CfExecute espera um ponteiro de memória bruto). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CloudFilterHost</RootNamespace>
    <!-- Gera um .exe único e independente, sem exigir que a pessoa tenha
         o .NET instalado separadamente pra rodar (facilita a distribuição
         junto do programa Electron). -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pacote da comunidade (nao da Microsoft, mas bem estabelecido e
         mantido ha anos) com as funcoes de baixo nivel de placeholder
         (CfConnectSyncRoot, CfCreatePlaceholders, CfExecute etc) ja
         empacotadas em C# - evita eu ter que escrever a comunicacao mais
         arriscada (layout exato de struct) do zero, sem poder testar. -->
    <PackageReference Include="Vanara.PInvoke.CldApi" Version="5.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
