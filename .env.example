# Database Configuration
DATABASE_URL=mysql://root:password@host:port/database

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server Configuration
NODE_ENV=production
PORT=3000

# Autenticação do site (senha única de acesso administrativo)
# APP_PASSWORD: a senha que os usuários digitam para liberar edições no site.
# SESSION_SECRET: string aleatória longa (32+ caracteres) usada para assinar o
# cookie de sessão. Gere uma com: openssl rand -hex 32
APP_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# OAuth Configuration (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
