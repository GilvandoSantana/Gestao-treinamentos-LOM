# Database Configuration
DATABASE_URL=mysql://root:password@host:port/database

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server Configuration
NODE_ENV=production
PORT=3000

# Autenticação do site (senha única de acesso administrativo)
# APP_PASSWORD: a senha que os usuários digitam para liberar edições no site.
# SESSION_SECRET: string aleatória longa (32+ caracteres) usada para assinar o
# cookie de sessão. Gere uma com: openssl rand -hex 32
APP_PASSWORD=troque-esta-senha
# Usuario do acesso mestre de recuperacao. A tela de login exige usuario e
# senha, entao defina aqui o usuario que voce vai digitar junto com o
# APP_PASSWORD. Escolha algo discreto - nao e exibido em lugar nenhum.
MASTER_USERNAME=troque-este-usuario
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Email Configuration (Optional) — via Resend (resend.com), gratuito ate 3 mil
# e-mails/mes. O Railway bloqueia SMTP direto, entao o envio e por API HTTPS.
RESEND_API_KEY=re_troque-por-sua-chave

# Opcional: remetente, se voce verificou um dominio proprio no Resend.
# Sem isso, usa onboarding@resend.dev (que so entrega para o e-mail da
# propria conta cadastrada no Resend, ate um dominio ser verificado).
RESEND_FROM_EMAIL=alertas@suaempresa.com

# Para quem os alertas de treinamento vencendo/vencido sao enviados.
# Aceita varios enderecos separados por virgula.
ALERT_RECIPIENT_EMAIL=rh@suaempresa.com

# WhatsApp (Opcional) — via Z-API (z-api.io). Servico pago (nao tem plano
# gratuito permanente); as credenciais ficam no painel da sua instancia.
ZAPI_INSTANCE_ID=troque-pelo-id-da-instancia
ZAPI_TOKEN=troque-pelo-token-da-instancia
# So necessario se sua conta Z-API exigir (aparece no painel, em Seguranca).
ZAPI_CLIENT_TOKEN=

# OAuth Configuration (Optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
